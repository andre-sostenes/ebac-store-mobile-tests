# Ambiente de execução: local | saucelabs
ENVIRONMENT=local

# Simulador iOS usado pelo local.conf.js
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.2
# Caminho opcional para o .app (padrão: ./app/LojaEBAC-sim.app)
# APP_PATH=./app/LojaEBAC-sim.app

# Credenciais do usuário de teste da EBAC Store
EBAC_EMAIL=cliente@ebac.art.br
EBAC_PASSWORD=GD*peToHNJ1#c$sgk08EaYJQ

# SauceLabs (necessário apenas quando ENVIRONMENT=saucelabs)
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_APP=storage:filename=LojaEBAC.ipa
SAUCE_DEVICE_NAME=iPhone 15.*
SAUCE_PLATFORM_VERSION=17
SAUCE_REGION=us-west-1
SAUCE_BUILD=ebac-store-ios

# true = gera também o relatório Allure
REPORTER=false
