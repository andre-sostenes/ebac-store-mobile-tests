# Ambiente de execução: local | browserstack | saucelabs
ENVIRONMENT=local

# Simulador iOS usado pelo local.conf.js
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.2
# Caminho opcional para o .app (padrão: ./app/LojaEBAC-sim.app)
# APP_PATH=./app/LojaEBAC-sim.app

# Credenciais do usuário de teste da EBAC Store
EBAC_EMAIL=cliente@ebac.art.br
EBAC_PASSWORD=GD*peToHNJ1#c$sgk08EaYJQ

# BrowserStack App Automate (necessário quando ENVIRONMENT=browserstack)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# Preenchido por `npm run bs:upload` (bs://...)
BROWSERSTACK_APP_URL=
BROWSERSTACK_DEVICE_NAME=iPhone 15
BROWSERSTACK_OS_VERSION=17
BROWSERSTACK_PROJECT=EBAC Store
BROWSERSTACK_BUILD=ebac-store-ios
BROWSERSTACK_NAME=EBAC Store - Checkout iOS

# SauceLabs (legado; necessário apenas quando ENVIRONMENT=saucelabs)
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=
# SAUCE_REGION=us-west-1
# SAUCE_APP=storage:filename=LojaEBAC-sim.zip
# SAUCE_DEVICE_NAME=iPhone 15 Simulator
# SAUCE_PLATFORM_VERSION=17.0

# true = gera também o relatório Allure
REPORTER=false
