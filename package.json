{
  "name": "ebac-store-ios-tests",
  "version": "1.0.0",
  "description": "Suíte de testes iOS (Appium + WebdriverIO) para o fluxo completo de checkout da EBAC Store",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^8.24.12",
    "@wdio/cli": "^8.26.1",
    "@wdio/globals": "^8.26.1",
    "@wdio/local-runner": "^8.26.1",
    "@wdio/mocha-framework": "^8.24.12",
    "@wdio/spec-reporter": "^8.24.12",
    "appium-xcuitest-driver": "^5.8.0",
    "dotenv": "^16.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "test": "wdio run ./config/wdio.conf.js",
    "test:checkout": "wdio run ./config/wdio.conf.js --suite checkout",
    "test:login": "wdio run ./config/wdio.conf.js --suite login",
    "test:search": "wdio run ./config/wdio.conf.js --suite search",
    "test:product": "wdio run ./config/wdio.conf.js --suite product",
    "report": "allure generate allure-results --clean && allure open"
  },
  "dependencies": {
    "allure-commandline": "^2.25.0"
  }
}
